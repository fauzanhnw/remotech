# Contoh config/.env untuk produksi (VPS).
# File asli ada di VPS: /home/deploy/remotech/config/.env (dibuat oleh setup-backend.sh).
# JANGAN commit file berisi secret ke repository.

# Security
SECRET_KEY=<digenerate-otomatis-oleh-setup-backend.sh>
DEBUG=false
ALLOWED_HOSTS=api.remotech.web.id

# Database (PostgreSQL lokal di VPS)
DB_NAME=remotech
DB_USER=remotech_user
DB_PASSWORD=<password-yang-dibuat-saat-setup-server.sh>
DB_HOST=localhost
DB_PORT=5432

# Email (SMTP Resend)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=<API-key-Resend>
DEFAULT_FROM_EMAIL=noreply@remotech.web.id

# Base URL
BASE_URL=https://api.remotech.web.id
FE_URL=https://remotech.web.id

# Midtrans (sandbox; set MIDTRANS_IS_PRODUCTION=true + key live untuk produksi)
MIDTRANS_SERVER_KEY=<Mid-server-...>
MIDTRANS_CLIENT_KEY=<Mid-client-...>
MIDTRANS_IS_PRODUCTION=false

# CORS — origin frontend yang diizinkan
CORS_ALLOWED_ORIGINS=https://remotech.web.id
